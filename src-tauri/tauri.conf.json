{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniKit",
  "mainBinaryName": "OmniKit",
  "version": "0.10.0",
  "identifier": "com.omnikit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OmniKit",
        "width": 1000,
        "height": 660,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFOUNCMEI0QUY1OTI1MzQKUldRMEpWbXZ0UENjbnVVUkw0T2JuendUZ0xWREprU05uYkY3R0dZN2Nuc0YrN29LV1Z6Q3dXcVAK",
      "endpoints": [
        "https://github.com/Rosons/omnikit/releases/latest/download/latest.json"
      ]
    }
  }
}
